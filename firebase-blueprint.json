{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized platform administrator record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile for customer or vendor",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "vendor", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Street food vendor and stall listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerName": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "rejectionReason": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "shopName", "ownerName", "status", "isOpen"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin collection storing authorized administrator credentials"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Users collection storing customer and vendor profiles"
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Vendors collection containing street stall listings and approval states"
    }
  }
}
