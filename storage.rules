rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isWithinSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Public read for all shop and food photos
    match /vendors/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isWithinSizeLimit();
    }

    // Profile photos
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImage() && isWithinSizeLimit();
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isWithinSizeLimit();
    }
  }
}
